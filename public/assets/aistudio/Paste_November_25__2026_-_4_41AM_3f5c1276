    <!-- ==================== STOCK HISTORY AUDIT LOG MODAL ==================== -->
    <div id="history-modal" class="hidden fixed sm:absolute inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
      <div class="sheet-panel w-full max-w-md bg-white dark:bg-obsidian-900 rounded-t-[32px] sm:rounded-[30px] border hairline-border max-h-[88vh] flex flex-col overflow-hidden shadow-2xl">
        <div class="px-5 py-4 border-b hairline-border flex items-center justify-between">
          <div class="flex items-center gap-2">
            <i data-lucide="history" class="w-4 h-4 text-champagne-500"></i>
            <h3 class="text-sm font-extrabold">Stock History Logbook</h3>
          </div>
          <button onclick="closeHistoryModal()" class="p-1.5 rounded-xl bg-alabaster-100 dark:bg-obsidian-800 text-slate-500">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <div id="history-list-container" class="p-4 overflow-y-auto space-y-2.5 flex-1 no-scrollbar">
          <!-- Populated dynamically -->
        </div>
