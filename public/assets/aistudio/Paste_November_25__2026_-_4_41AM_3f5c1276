          quantity: newQty,
          threshold,
          image: state.capturedImageBase64 || (existing ? existing.image : null),
          updatedAt: Date.now()
        };

        const historyObj = {
          type: 'IN',
          itemName: name,
          quantity: qtyDelta,
          resultingStock: newQty,
          image: itemObj.image,
          timestamp: Date.now(),
          offlineSynced: !isEffectivelyOnline()
        };

        await persistItemOperation('upsert', itemObj, historyObj);
        showToast(`+${qtyDelta} "${name}" logged · Total: ${newQty}`, 'success');
      } else {
        if (!existing) {
          showToast('Item not matched. Use Help · Select Manually above.', 'error');
          return;
        }
        if (Number(existing.quantity) < qtyDelta) {
          showToast(`Insufficient stock: only ${existing.quantity} units available.`, 'error');
          return;
        }

        const newQty = Number(existing.quantity) - qtyDelta;
        const itemObj = {
          ...existing,
          name,
          category,
          quantity: newQty,
          image: existing.image || state.capturedImageBase64,
          updatedAt: Date.now()
        };

        const historyObj = {
          type: 'OUT',
          itemName: name,
          quantity: qtyDelta,
          resultingStock: newQty,
          image: itemObj.image,
          timestamp: Date.now(),
          offlineSynced: !isEffectivelyOnline()
        };

        await persistItemOperation('upsert', itemObj, historyObj);

        if (newQty <= Number(itemObj.threshold ?? 5)) {
          showToast(`Low Stock Warning: "${name}" is at ${newQty} units`, 'warning');
        } else {
          showToast(`-${qtyDelta} "${name}" deducted · Remaining: ${newQty}`, 'success');
        }
      }

      closeScanModal();
    };

    // --- Direct Item Edit & Delete ---
    window.openEditModal = function(itemId) {
      const item = state.items.find(i => i.id === itemId);
      if (!item) return;
      document.getElementById('edit-modal-id').value = item.id;
      document.getElementById('edit-modal-name').value = item.name;
      document.getElementById('edit-modal-category').value = item.category || 'General';
      document.getElementById('edit-modal-qty').value = item.quantity;
      document.getElementById('edit-modal-threshold').value = item.threshold ?? 5;
      document.getElementById('edit-item-modal').classList.remove('hidden');
    };

    window.closeEditModal = function() {
      document.getElementById('edit-item-modal').classList.add('hidden');
    };

    window.saveDirectItemEdit = async function(e) {
      e.preventDefault();
      const id = document.getElementById('edit-modal-id').value;
      const existing = state.items.find(i => i.id === id);
      if (!existing) return;

      const updated = {
        ...existing,
        name: document.getElementById('edit-modal-name').value.trim(),
        category: document.getElementById('edit-modal-category').value.trim() || 'General',
        quantity: Math.max(0, Number(document.getElementById('edit-modal-qty').value) || 0),
        threshold: Math.max(0, Number(document.getElementById('edit-modal-threshold').value) || 0),
        updatedAt: Date.now()
      };

      await persistItemOperation('upsert', updated, null);
      closeEditModal();
      showToast('Inventory item updated.', 'success');
    };

    window.deleteCurrentEditItem = async function() {
      const id = document.getElementById('edit-modal-id').value;
      const existing = state.items.find(i => i.id === id);
      if (!existing) return;
      await persistItemOperation('delete', existing, null);
      closeEditModal();
      showToast(`Removed "${existing.name}" from inventory.`, 'info');
    };

    // --- Stock History Audit Logbook ---
    window.openHistoryModal = function() {
      const container = document.getElementById('history-list-container');
      if (state.history.length === 0) {
        container.innerHTML = `
          <div class="p-10 text-center text-xs text-slate-400">
            No Stock IN or Stock OUT entries recorded yet.
          </div>
        `;
      } else {
        container.innerHTML = state.history.map(entry => {
          const isIn = entry.type === 'IN';
          const dateStr = new Date(entry.timestamp).toLocaleString([], {
            month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
          });
          const thumb = entry.image
            ? `<img src="${entry.image}" class="w-10 h-10 rounded-xl object-cover shrink-0 bg-obsidian-800 border hairline-border" />`
            : `<div class="w-10 h-10 rounded-xl bg-alabaster-100 dark:bg-obsidian-850 flex items-center justify-center text-slate-400 shrink-0 border hairline-border"><i data-lucide="package" class="w-4 h-4"></i></div>`;

          return `
            <div class="p-3 rounded-2xl bg-alabaster-50 dark:bg-obsidian-850 border hairline-border flex items-center justify-between gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                ${thumb}
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <p class="text-xs font-extrabold truncate">${entry.itemName}</p>
                    ${entry.offlineSynced ? `<span class="px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-500 text-[8px] font-bold uppercase">Local</span>` : ''}
                  </div>
                  <p class="text-[10px] text-slate-400 tabular-nums mt-0.5">${dateStr} · Bal: ${entry.resultingStock}</p>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-xl text-[11px] font-extrabold tabular-nums shrink-0 ${isIn ? 'bg-emerald-500/12 text-emerald-600 dark:text-emeraldNeon-400' : 'bg-rose-500/12 text-rose-500'}">
                ${isIn ? '+' : '-'}${entry.quantity} ${entry.type}
              </span>
            </div>
          `;
        }).join('');
      }
      document.getElementById('history-modal').classList.remove('hidden');
      lucide.createIcons();
    };

    window.closeHistoryModal = function() {
      document.getElementById('history-modal').classList.add('hidden');
    };

    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
    });
  </script>
</body>
</html>