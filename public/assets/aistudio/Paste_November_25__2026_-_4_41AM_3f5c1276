              <input id="edit-modal-ocr" type="text" placeholder="e.g. DENIM CO." class="w-full px-3.5 py-2.5 rounded-xl bg-alabaster-50 dark:bg-obsidian-850 border hairline-border text-xs font-bold text-emerald-600 dark:text-emeraldNeon-400" />
