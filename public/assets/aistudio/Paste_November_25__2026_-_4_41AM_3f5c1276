<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>AURELIA STOCK — AI Vision Inventory Suite</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'system-ui', 'sans-serif'],
            display: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            obsidian: {
              950: '#0A0C10',
              900: '#12151C',
              850: '#161A23',
              800: '#191D26',
              700: '#232834',
            },
            alabaster: {
              50: '#F7F8FA',
              100: '#EEF1F6',
              200: '#E2E6EE',
            },
            champagne: {
              400: '#E5C158',
              500: '#D4AF37',
              600: '#B89427',
            },
            emeraldNeon: {
              400: '#00E676',
              500: '#10B981',
            },
          },
        },
      },
    };
  </script>

  <style>
    * {
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
    }
    body {
      font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
      overflow-x: hidden;
      transition: background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease;
    }

    /* Tabular numbers for metrics, quantities & timestamps */
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    /* Hairline luxury borders */
    .hairline-border {
      border-color: rgba(15, 23, 42, 0.08);
    }
    .dark .hairline-border {
      border-color: rgba(255, 255, 255, 0.08);
    }

    /* Precision Emerald Neon Pulse */
    @keyframes pulse-emerald {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.55), 0 0 8px #00E676;
        transform: scale(1);
      }
      50% {
        box-shadow: 0 0 0 4px rgba(0, 230, 118, 0), 0 0 12px #00E676;
        transform: scale(1.08);
      }
    }
    .neon-dot-active {
      background-color: #00E676;
      animation: pulse-emerald 2.2s infinite ease-in-out;
    }
    .neon-dot-offline {
      background-color: #F59E0B;
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.65);
    }
    .neon-dot-paused {
      background-color: #64748B;
    }

    /* AI Laser Scanline Animation */
    @keyframes laser-sweep {
      0% {
        top: 6%;
        opacity: 0.2;
      }
      15% {
        opacity: 1;
      }
      85% {
        opacity: 1;
      }
      100% {
        top: 92%;
        opacity: 0.2;
      }
    }
    .ai-laser-line {
      position: absolute;
      left: 4%;
      right: 4%;
      height: 2px;
      background: linear-gradient(90deg, transparent, #00E676, #E5C158, #00E676, transparent);
      box-shadow: 0 0 14px #00E676, 0 0 28px rgba(0, 230, 118, 0.65);
      animation: laser-sweep 1.8s infinite alternate cubic-bezier(0.45, 0.05, 0.55, 0.95);
      z-index: 20;
    }

    /* Shimmer effect */
    @keyframes shimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }
    .shimmer-overlay::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
      animation: shimmer 1.6s infinite;
    }

    /* Minimal Scrollbar */
    ::-webkit-scrollbar {
      width: 3px;
      height: 3px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.25);
      border-radius: 9999px;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Drawer & Modal Spring Transitions */
    .drawer-panel {
      transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sheet-panel {
      animation: sheet-up 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes sheet-up {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
  </style>
</head>
<body class="bg-alabaster-100 text-slate-900 dark:bg-[#06070A] dark:text-slate-100 min-h-screen flex flex-col items-center justify-center selection:bg-champagne-500/30">

  <!-- Executive Toast / Message Box (Never using alert/confirm) -->
  <div id="toast-container" class="fixed top-5 left-1/2 -translate-x-1/2 z-[100] flex flex-col gap-2 w-[92%] max-w-[400px] pointer-events-none"></div>

  <!-- Executive Mobile-First Viewport Frame (Edge-to-edge on mobile, framed luxury device on desktop) -->
  <div id="app-shell" class="w-full sm:w-[430px] min-h-screen sm:min-h-[860px] sm:max-h-[92vh] sm:my-6 sm:rounded-[38px] bg-alabaster-50 dark:bg-obsidian-950 sm:shadow-[0_28px_80px_-15px_rgba(0,0,0,0.65)] border-x sm:border hairline-border flex flex-col relative overflow-hidden transition-all duration-200">

    <!-- ==================== AUTHENTICATION SCREEN ==================== -->
    <div id="auth-screen" class="flex-1 flex flex-col justify-between p-6 sm:p-7 bg-gradient-to-b from-white via-alabaster-50 to-alabaster-100 dark:from-obsidian-900 dark:via-obsidian-950 dark:to-obsidian-950 overflow-y-auto">
      <div class="pt-3">
        <!-- Brand Header -->
        <div class="flex items-center justify-between mb-9">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-champagne-500/20 to-champagne-600/5 border border-champagne-500/35 flex items-center justify-center text-champagne-500 shadow-inner">
              <i data-lucide="scan-line" class="w-5 h-5"></i>
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <h1 class="text-base font-extrabold tracking-tight">SmartStock</h1>
                <span class="px-1.5 py-0.5 text-[9px] font-extrabold uppercase tracking-widest rounded-md bg-champagne-500/15 text-champagne-600 dark:text-champagne-400 border border-champagne-500/25">AI</span>
              </div>
              <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Executive Vision Inventory</p>
            </div>
          </div>

          <button onclick="toggleTheme()" class="w-10 h-10 rounded-2xl bg-white dark:bg-obsidian-800 border hairline-border text-slate-600 dark:text-champagne-400 flex items-center justify-center hover:scale-105 active:scale-95 transition shadow-xs" title="Toggle Day / Night Mode">
            <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
            <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
          </button>
        </div>

        <!-- Hero Headline -->
        <div class="mb-7">
          <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-champagne-600 dark:text-champagne-400 mb-1.5">Private Cloud Workspace</p>
          <h2 id="auth-title" class="text-2xl font-extrabold tracking-tight leading-snug mb-1.5">Precision Inventory,<br/>Powered by Vision AI.</h2>
          <p id="auth-subtitle" class="text-xs leading-relaxed text-slate-500 dark:text-slate-400">Sign in to access your isolated cloud ledger, instant photo recognition, and offline sync engine.</p>
        </div>

        <!-- Segmented Auth Switcher -->
        <div class="grid grid-cols-2 p-1 rounded-2xl bg-alabaster-100 dark:bg-obsidian-900 border hairline-border mb-5">
          <button id="tab-login" onclick="setAuthMode('login')" class="py-2.5 text-xs font-bold rounded-xl bg-white dark:bg-obsidian-800 shadow-xs text-slate-900 dark:text-white transition">Sign In</button>
          <button id="tab-signup" onclick="setAuthMode('signup')" class="py-2.5 text-xs font-semibold rounded-xl text-slate-500 dark:text-slate-400 transition">Create Account</button>
        </div>

        <!-- Auth Form -->
        <form id="auth-form" onsubmit="handleEmailAuth(event)" class="space-y-3.5">
          <div id="name-field-wrap" class="hidden">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">Workspace / Store Name</label>
            <input id="auth-name" type="text" placeholder="e.g. Atelier Studio" class="w-full px-4 py-3 rounded-2xl bg-white dark:bg-obsidian-900 border hairline-border text-sm font-medium focus:outline-none focus:ring-2 focus:ring-champagne-500/60 transition" />
          </div>
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">Email Address</label>
            <input id="auth-email" type="email" required placeholder="founder@company.com" class="w-full px-4 py-3 rounded-2xl bg-white dark:bg-obsidian-900 border hairline-border text-sm font-medium focus:outline-none focus:ring-2 focus:ring-champagne-500/60 transition" />
          </div>
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">Password</label>
            <input id="auth-password" type="password" required minlength="6" placeholder="••••••••" class="w-full px-4 py-3 rounded-2xl bg-white dark:bg-obsidian-900 border hairline-border text-sm font-medium focus:outline-none focus:ring-2 focus:ring-champagne-500/60 transition" />
          </div>
          <button type="submit" id="auth-submit-btn" class="w-full py-3.5 rounded-2xl bg-slate-900 dark:bg-gradient-to-r dark:from-champagne-500 dark:to-champagne-400 hover:opacity-95 active:scale-[0.99] text-white dark:text-obsidian-950 font-bold text-sm shadow-lg shadow-champagne-500/15 transition flex items-center justify-center gap-2 mt-1">
            <span>Enter Cloud Workspace</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </form>

        <div class="relative my-5">
          <div class="absolute inset-0 flex items-center"><div class="w-full border-t hairline-border"></div></div>
          <div class="relative flex justify-center text-[11px]"><span class="px-3 bg-alabaster-50 dark:bg-obsidian-950 text-slate-400 font-medium">or instant access</span></div>
        </div>

        <!-- Instant Isolated Demo Workspace -->
        <button onclick="handleInstantCloudLogin()" class="w-full py-3.5 px-4 rounded-2xl bg-white dark:bg-obsidian-900 hover:bg-alabaster-100 dark:hover:bg-obsidian-800 text-slate-800 dark:text-slate-100 font-semibold text-xs border hairline-border flex items-center justify-center gap-2.5 transition active:scale-[0.99] shadow-xs">
          <span class="w-2 h-2 rounded-full neon-dot-active"></span>
          <span>Launch Instant Isolated Demo Workspace</span>
        </button>
      </div>

      <!-- Footer Support Link -->
      <div class="pt-6 text-center space-y-2">
        <p class="text-[10px] font-medium tracking-wide text-slate-400">END-TO-END ISOLATED LEDGER • OFFLINE AUTO-SYNC</p>
        <a href="https://wa.me/917011162050?text=Hello%20SmartStock%20AI%20Support%2C%20I%20need%20help%20with%20my%20account." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emeraldNeon-400 hover:underline">
          <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
          <span>Concierge WhatsApp Support · 7011162050</span>
        </a>
      </div>
    </div>

    <!-- ==================== MAIN APP DASHBOARD ==================== -->
    <div id="main-app" class="hidden flex-1 flex flex-col pb-28 overflow-y-auto no-scrollbar">

      <!-- GLASSMORPHIC TOP APP BAR (Mirrors cleanly for Left-Handed / Right-Handed Ergonomics) -->
      <header id="top-header" class="sticky top-0 z-30 bg-white/80 dark:bg-obsidian-950/80 backdrop-blur-xl border-b hairline-border px-4 py-3 flex items-center justify-between gap-2">
        <!-- Profile Avatar Trigger (Defaults to Top-Left for Left-Handed Ergonomics) -->
        <button id="profile-trigger-btn" onclick="openProfileDrawer()" class="flex items-center gap-2.5 p-1 pr-3 rounded-2xl bg-alabaster-100/90 dark:bg-obsidian-900 hover:bg-alabaster-200/70 dark:hover:bg-obsidian-800 border hairline-border transition active:scale-95 group" title="Profile, Hand Orientation & Settings">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-champagne-400 to-champagne-600 text-obsidian-950 font-extrabold text-xs flex items-center justify-center shadow-sm" id="user-avatar-initials">U</div>
          <div class="text-left">
            <p id="header-user-name" class="text-xs font-bold leading-tight truncate max-w-[92px]">My Store</p>
            <p id="hand-mode-badge" class="text-[10px] font-medium text-champagne-600 dark:text-champagne-400 leading-tight">Left-Hand</p>
          </div>
        </button>

        <!-- Precision Neon Status Pills -->
        <div id="status-pills-container" class="flex items-center gap-1.5">
          <!-- AI Agent Ready Pill -->
          <div id="ai-status-pill" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-alabaster-100/90 dark:bg-obsidian-900 border hairline-border">
            <span id="ai-status-dot" class="w-2 h-2 rounded-full neon-dot-active"></span>
            <span id="ai-status-text" class="text-[10px] font-semibold tracking-tight text-slate-700 dark:text-slate-200">AI Agent Ready</span>
          </div>

          <!-- Online / Offline Status Pill -->
          <div id="net-status-pill" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-alabaster-100/90 dark:bg-obsidian-900 border hairline-border">
            <span id="net-status-dot" class="w-2 h-2 rounded-full neon-dot-active"></span>
            <span id="net-status-text" class="text-[10px] font-semibold tracking-tight text-slate-700 dark:text-slate-200">Online</span>
          </div>
        </div>
      </header>

      <!-- Subtle Offline / Sync Status Banner -->
      <div id="offline-banner" class="hidden bg-amber-500/10 border-b border-amber-500/25 px-4 py-2 flex items-center justify-between text-[11px] text-amber-700 dark:text-amber-300">
        <div class="flex items-center gap-2">
          <i data-lucide="wifi-off" class="w-3.5 h-3.5 shrink-0 text-amber-500"></i>
          <span><strong>Offline · Manual:</strong> AI paused. Local cache active.</span>
        </div>
        <span id="pending-sync-count" class="px-2 py-0.5 rounded-full bg-amber-500/20 font-bold text-[10px] tabular-nums">0 queued</span>
      </div>

      <!-- EXECUTIVE KPI BENTO CARDS -->
      <section class="p-4 pb-2 grid grid-cols-2 gap-3">
        <!-- Total Stock Card -->
        <button onclick="setStockFilter('all')" id="card-total-stock" class="text-left p-4 rounded-[24px] bg-white dark:bg-obsidian-900 border border-champagne-500/45 shadow-xs transition active:scale-[0.98] relative overflow-hidden">
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-xl bg-champagne-500/15 text-champagne-600 dark:text-champagne-400 flex items-center justify-center">
              <i data-lucide="layers" class="w-4 h-4"></i>
            </span>
            <span id="unique-items-badge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-alabaster-100 dark:bg-obsidian-800 text-slate-600 dark:text-slate-300 tabular-nums">0 SKUs</span>
          </div>
          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Stock</p>
          <p id="total-stock-qty" class="text-2xl font-extrabold tracking-tight mt-0.5 tabular-nums">0</p>
        </button>

        <!-- Low Stock Alerts Card -->
        <button onclick="setStockFilter('low')" id="card-low-stock" class="text-left p-4 rounded-[24px] bg-white dark:bg-obsidian-900 border hairline-border hover:border-rose-500/40 shadow-xs transition active:scale-[0.98] relative overflow-hidden">
          <div class="flex items-center justify-between mb-3">
            <span class="w-8 h-8 rounded-xl bg-rose-500/12 text-rose-500 flex items-center justify-center">
              <i data-lucide="alert-circle" class="w-4 h-4"></i>
            </span>
            <span id="low-stock-pill" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-500/12 text-rose-500 tabular-nums">0 Alerts</span>
          </div>
          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Low Stock Alerts</p>
          <p id="low-stock-count" class="text-2xl font-extrabold tracking-tight mt-0.5 text-rose-500 tabular-nums">0</p>
        </button>
      </section>

      <!-- SEARCH, FILTER PILLS & DENSITY TOGGLE -->
      <section class="px-4 py-2 space-y-2.5">
        <div class="flex items-center gap-2">
          <div class="relative flex-1">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input id="search-input" oninput="renderStockList()" type="text" placeholder="Search items, SKU or category..." class="w-full pl-10 pr-8 py-2.5 rounded-2xl bg-white dark:bg-obsidian-900 border hairline-border text-xs font-medium focus:outline-none focus:ring-2 focus:ring-champagne-500/50 transition" />
            <button id="clear-search-btn" onclick="clearSearch()" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
              <i data-lucide="x-circle" class="w-4 h-4"></i>
            </button>
          </div>
          <!-- List / Grid Density Toggle -->
          <button onclick="toggleViewDensity()" id="density-toggle-btn" class="w-10 h-10 rounded-2xl bg-white dark:bg-obsidian-900 border hairline-border text-slate-500 dark:text-slate-300 flex items-center justify-center shrink-0 hover:border-champagne-500/40 transition active:scale-95" title="Switch List / Grid View">
            <i id="density-icon" data-lucide="layout-grid" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- Segmented Filter Pills -->
        <div id="category-pills" class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar">
          <!-- Dynamically populated -->
        </div>
      </section>

      <!-- INVENTORY LIST / GRID -->
      <main class="px-4 pt-1 flex-1">
        <div class="flex items-center justify-between mb-2.5">
          <h2 id="list-heading" class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">All Inventory</h2>
          <button onclick="openHistoryModal()" class="text-[11px] font-bold text-champagne-600 dark:text-champagne-400 hover:underline flex items-center gap-1">
            <i data-lucide="history" class="w-3.5 h-3.5"></i>
            <span>Audit Log</span>
          </button>
        </div>

        <div id="stock-list-container" class="space-y-2.5">
          <!-- Populated dynamically via JS -->
        </div>
      </main>

      <!-- ERGONOMIC THUMB-ZONE FLOATING ACTION DOCK -->
      <div id="bottom-action-dock-wrap" class="fixed sm:absolute bottom-4 inset-x-0 z-30 px-4 flex justify-start pointer-events-none">
        <div id="bottom-action-bar" class="pointer-events-auto w-full max-w-[398px] flex items-center gap-2.5 p-2 rounded-[26px] bg-white/90 dark:bg-obsidian-900/90 backdrop-blur-2xl border hairline-border shadow-[0_16px_40px_-10px_rgba(0,0,0,0.45)]">
          <button onclick="openScanModal('IN')" class="flex-1 py-3.5 px-4 rounded-2xl bg-slate-900 dark:bg-gradient-to-r dark:from-champagne-500 dark:to-champagne-400 hover:opacity-95 active:scale-[0.97] text-white dark:text-obsidian-950 font-extrabold text-xs tracking-wide shadow-md flex items-center justify-center gap-2 transition">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span>Stock IN</span>
          </button>
          <button onclick="openScanModal('OUT')" class="flex-1 py-3.5 px-4 rounded-2xl bg-alabaster-100 dark:bg-obsidian-800 hover:bg-alabaster-200 dark:hover:bg-obsidian-700 active:scale-[0.97] text-slate-900 dark:text-white font-extrabold text-xs tracking-wide border hairline-border flex items-center justify-center gap-2 transition">
            <i data-lucide="minus-circle" class="w-4 h-4 text-rose-500"></i>
            <span>Stock OUT</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ==================== PROFILE & SETTINGS SLIDE-OVER DRAWER ==================== -->
    <div id="profile-drawer-backdrop" onclick="closeProfileDrawer()" class="hidden fixed sm:absolute inset-0 z-40 bg-black/65 backdrop-blur-xs transition-opacity"></div>
    <aside id="profile-drawer" class="fixed sm:absolute top-0 left-0 bottom-0 w-[86%] max-w-[335px] z-50 bg-white dark:bg-obsidian-900 border-r hairline-border p-5 flex flex-col justify-between -translate-x-full drawer-panel overflow-y-auto no-scrollbar">
      <div>
        <!-- Drawer Header with UID Isolation Badge -->
        <div class="flex items-start justify-between pb-4 border-b hairline-border">
          <div class="flex items-center gap-3">
            <div id="drawer-avatar" class="w-11 h-11 rounded-2xl bg-gradient-to-br from-champagne-400 to-champagne-600 text-obsidian-950 font-extrabold text-base flex items-center justify-center shadow-sm">U</div>
            <div>
              <h3 id="drawer-user-name" class="text-sm font-extrabold">Store Owner</h3>
              <p id="drawer-user-email" class="text-[11px] text-slate-500 dark:text-slate-400 truncate max-w-[165px]">user@store.com</p>
              <span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emeraldNeon-400 text-[9px] font-bold">
                <i data-lucide="shield-check" class="w-2.5 h-2.5"></i>
                <span id="drawer-uid-badge">Isolated Cloud UID</span>
              </span>
            </div>
          </div>
          <button onclick="closeProfileDrawer()" class="p-2 rounded-xl bg-alabaster-100 dark:bg-obsidian-800 text-slate-500 hover:text-slate-800 dark:hover:text-white transition">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- Settings Controls -->
        <div class="py-4 space-y-3.5">

          <!-- 1. Hand Orientation Switch -->
          <div class="p-3.5 rounded-2xl bg-alabaster-50 dark:bg-obsidian-850 border hairline-border">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <i data-lucide="hand" class="w-4 h-4 text-champagne-500"></i>
                <span class="text-xs font-bold">Hand Orientation</span>
              </div>
              <span id="drawer-hand-label" class="text-[10px] font-bold uppercase tracking-wider text-champagne-600 dark:text-champagne-400">Left</span>
