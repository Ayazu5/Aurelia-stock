  </div>

  <!-- ==================== FIREBASE & APPLICATION LOGIC ==================== -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import {
      getAuth,
      signInWithEmailAndPassword,
      createUserWithEmailAndPassword,
      signInAnonymously,
      signInWithCustomToken,
      onAuthStateChanged,
      signOut,
      updateProfile
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import {
      getFirestore,
      doc,
      setDoc,
      deleteDoc,
      addDoc,
      onSnapshot,
      collection
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    // --- Environment & Firebase Setup ---
    const appId = typeof __app_id !== 'undefined' ? __app_id : 'smart-stock-ai-app';
    let firebaseConfig = null;
    try {
      if (typeof __firebase_config !== 'undefined' && __firebase_config) {
        firebaseConfig = JSON.parse(__firebase_config);
      }
    } catch (e) {
      console.warn("Firebase config fallback:", e);
    }

    let app = null;
    let auth = null;
    let db = null;
    let useCloudMode = false;

    if (firebaseConfig && firebaseConfig.apiKey) {
      try {
        app = initializeApp(firebaseConfig);
        auth = getAuth(app);
        db = getFirestore(app);
        useCloudMode = true;
      } catch (err) {
        console.warn("Firebase init error, using isolated local storage fallback:", err);
      }
    }

    // --- Application State ---
    const state = {
      user: null,
      authMode: 'login',
      items: [],
      history: [],
      filter: 'all',
      viewDensity: 'list', // 'list' | 'grid'
      handSide: 'left',    // Default Left-Handed
      theme: 'dark',       // Default Obsidian Dark
      uiScale: 100,
      photoQuality: 'medium',
      isOnline: navigator.onLine,
      simulatedOffline: false,
      offlineQueue: [],
      scanMode: 'IN',
      capturedImageBase64: null,
      capturedFingerprint: null,
      lastUploadedFilename: '',
      pendingNewSuggestion: null,
      selectedCandidateId: null,
      cameraStream: null,
      cameraFacingMode: 'environment',
      unsubscribeItems: null,
      unsubscribeHistory: null
    };

    // --- Toast Notification (Zero alert/confirm) ---
    window.showToast = function(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const styles = {
        success: 'bg-obsidian-900 dark:bg-obsidian-800 text-emeraldNeon-400 border-emerald-500/40',
        error: 'bg-rose-950 text-rose-200 border-rose-500/40',
        warning: 'bg-amber-950 text-amber-200 border-amber-500/40',
        info: 'bg-slate-900 dark:bg-obsidian-800 text-slate-100 border-champagne-500/35'
      };
      toast.className = `pointer-events-auto px-4 py-3 rounded-2xl border shadow-2xl text-xs font-bold flex items-center justify-between gap-3 transition-all duration-300 backdrop-blur-xl ${styles[type] || styles.info}`;
      toast.innerHTML = `<span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-8px)';
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    };

    function isEffectivelyOnline() {
      return state.isOnline && !state.simulatedOffline;
    }

    // --- Update Neon Status Pills & Offline Sync Banner ---
    function updateConnectivityUI() {
      const online = isEffectivelyOnline();
      const aiDot = document.getElementById('ai-status-dot');
      const aiText = document.getElementById('ai-status-text');
      const netDot = document.getElementById('net-status-dot');
      const netText = document.getElementById('net-status-text');
      const offlineBanner = document.getElementById('offline-banner');
      const pendingCountEl = document.getElementById('pending-sync-count');

      if (online) {
        aiDot.className = 'w-2 h-2 rounded-full neon-dot-active';
        aiText.textContent = 'AI Agent Ready';
        netDot.className = 'w-2 h-2 rounded-full neon-dot-active';
        netText.textContent = 'Online';
        offlineBanner.classList.add('hidden');
      } else {
        aiDot.className = 'w-2 h-2 rounded-full neon-dot-paused';
        aiText.textContent = 'AI Paused';
        netDot.className = 'w-2 h-2 rounded-full neon-dot-offline';
        netText.textContent = 'Offline · Manual';
        offlineBanner.classList.remove('hidden');
        pendingCountEl.textContent = `${state.offlineQueue.length} queued`;
      }
    }

    window.addEventListener('online', () => {
      state.isOnline = true;
      updateConnectivityUI();
      showToast('Connection restored · Syncing offline ledger...', 'success');
      flushOfflineQueue();
    });

    window.addEventListener('offline', () => {
      state.isOnline = false;
      updateConnectivityUI();
      showToast('Offline · Manual Mode engaged.', 'warning');
    });

    window.toggleSimulatedOffline = function(checked) {
      state.simulatedOffline = checked;
      updateConnectivityUI();
      if (checked) {
        showToast('Simulated Offline Mode active — AI paused.', 'warning');
      } else {
        showToast('Back Online — AI Agent Ready & syncing.', 'success');
        flushOfflineQueue();
      }
    };

    // --- Authentication ---
    window.setAuthMode = function(mode) {
      state.authMode = mode;
      const isSignup = mode === 'signup';
      document.getElementById('name-field-wrap').classList.toggle('hidden', !isSignup);
      document.getElementById('auth-title').innerHTML = isSignup
        ? 'Create Your<br/>Isolated Ledger.'
        : 'Precision Inventory,<br/>Powered by Vision AI.';
      document.getElementById('auth-submit-btn').querySelector('span').textContent = isSignup
        ? 'Create Cloud Workspace'
        : 'Enter Cloud Workspace';

      document.getElementById('tab-login').className = !isSignup
        ? 'py-2.5 text-xs font-bold rounded-xl bg-white dark:bg-obsidian-800 shadow-xs text-slate-900 dark:text-white transition'
        : 'py-2.5 text-xs font-semibold rounded-xl text-slate-500 dark:text-slate-400 transition';
      document.getElementById('tab-signup').className = isSignup
        ? 'py-2.5 text-xs font-bold rounded-xl bg-white dark:bg-obsidian-800 shadow-xs text-slate-900 dark:text-white transition'
        : 'py-2.5 text-xs font-semibold rounded-xl text-slate-500 dark:text-slate-400 transition';
    };

    window.handleEmailAuth = async function(e) {
      e.preventDefault();
      const email = document.getElementById('auth-email').value.trim();
      const password = document.getElementById('auth-password').value;
      const storeName = document.getElementById('auth-name').value.trim() || email.split('@')[0];

      if (useCloudMode && auth) {
        try {
          if (state.authMode === 'signup') {
            const cred = await createUserWithEmailAndPassword(auth, email, password);
            await updateProfile(cred.user, { displayName: storeName });
            showToast('Private cloud workspace created!', 'success');
          } else {
            await signInWithEmailAndPassword(auth, email, password);
            showToast('Authenticated securely.', 'success');
          }
        } catch (err) {
          showToast(err.message.replace('Firebase:', '').trim(), 'error');
        }
      } else {
        const localUid = 'usr_' + btoa(email).replace(/[^a-zA-Z0-9]/g, '').slice(0, 12);
        onUserAuthenticated({ uid: localUid, email, displayName: storeName });
      }
    };

    window.handleInstantCloudLogin = async function() {
      if (useCloudMode && auth) {
        try {
          if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
            await signInWithCustomToken(auth, __initial_auth_token);
          } else {
            await signInAnonymously(auth);
          }
          showToast('Connected to isolated Cloud Demo Workspace.', 'success');
        } catch (err) {
          onUserAuthenticated({ uid: 'demo_isolated_01', email: 'demo@smartstock.ai', displayName: 'Atelier Demo' });
        }
      } else {
        onUserAuthenticated({ uid: 'demo_isolated_01', email: 'demo@smartstock.ai', displayName: 'Atelier Demo' });
      }
    };

    window.handleLogout = async function() {
      closeProfileDrawer();
      if (state.unsubscribeItems) state.unsubscribeItems();
      if (state.unsubscribeHistory) state.unsubscribeHistory();
      if (useCloudMode && auth) {
        try { await signOut(auth); } catch (e) {}
      }
      state.user = null;
      state.items = [];
      state.history = [];
      document.getElementById('main-app').classList.add('hidden');
      document.getElementById('auth-screen').classList.remove('hidden');
      showToast('Signed out safely.', 'info');
    };

    if (useCloudMode && auth) {
      onAuthStateChanged(auth, (user) => {
        if (user) onUserAuthenticated(user);
      });
    }

    function onUserAuthenticated(user) {
      state.user = user;
      const displayName = user.displayName || (user.email ? user.email.split('@')[0] : 'My Store');
      const email = user.email || `UID: ${user.uid.slice(0, 10)}...`;

      document.getElementById('header-user-name').textContent = displayName;
      document.getElementById('drawer-user-name').textContent = displayName;
      document.getElementById('drawer-user-email').textContent = email;
      document.getElementById('drawer-uid-badge').textContent = `Isolated ID: ${user.uid.slice(0, 8)}`;

      const initial = displayName.charAt(0).toUpperCase();
      document.getElementById('user-avatar-initials').textContent = initial;
      document.getElementById('drawer-avatar').textContent = initial;

      document.getElementById('auth-screen').classList.add('hidden');
      document.getElementById('main-app').classList.remove('hidden');

      loadUserPreferences();
      loadOfflineQueue();
      subscribeToUserStock();
      updateConnectivityUI();
      lucide.createIcons();
    }

    // --- User Settings & Ergonomics ---
    function getPrefKey() {
      return `smartstock_prefs_v2_${state.user?.uid || 'guest'}`;
    }

    function loadUserPreferences() {
      try {
        const saved = JSON.parse(localStorage.getItem(getPrefKey()) || '{}');
        setHandPreference(saved.handSide || 'left', false);
        applyTheme(saved.theme || 'dark', false);
        setUiScale(saved.uiScale || 100, false);
        setPhotoQuality(saved.photoQuality || 'medium', false);
        if (saved.viewDensity) {
          state.viewDensity = saved.viewDensity;
          updateDensityIcon();
        }
      } catch (e) {}
    }

    function saveUserPreferences() {
      try {
        localStorage.setItem(getPrefKey(), JSON.stringify({
          handSide: state.handSide,
          theme: state.theme,
          uiScale: state.uiScale,
          photoQuality: state.photoQuality,
          viewDensity: state.viewDensity
        }));
      } catch (e) {}
    }

    window.setHandPreference = function(side, persist = true) {
      state.handSide = side;
      const header = document.getElementById('top-header');
      const actionBar = document.getElementById('bottom-action-bar');
      const dockWrap = document.getElementById('bottom-action-dock-wrap');
      const drawer = document.getElementById('profile-drawer');
      const badge = document.getElementById('hand-mode-badge');
      const drawerLabel = document.getElementById('drawer-hand-label');
      const btnLeft = document.getElementById('btn-hand-left');
      const btnRight = document.getElementById('btn-hand-right');

      const activeBtnClass = 'py-1.5 text-xs font-bold rounded-lg bg-slate-900 dark:bg-champagne-500 text-white dark:text-obsidian-950 transition';
      const inactiveBtnClass = 'py-1.5 text-xs font-semibold rounded-lg text-slate-500 dark:text-slate-400 transition';

      if (side === 'left') {
        header.classList.remove('flex-row-reverse');
        actionBar.classList.remove('flex-row-reverse');
        dockWrap.classList.remove('justify-end');
        dockWrap.classList.add('justify-start');
        drawer.classList.remove('right-0', 'border-l', 'translate-x-full');
        drawer.classList.add('left-0', 'border-r');
        badge.textContent = 'Left-Hand';
        drawerLabel.textContent = 'Left';
        btnLeft.className = activeBtnClass;
        btnRight.className = inactiveBtnClass;
      } else {
        header.classList.add('flex-row-reverse');
        actionBar.classList.add('flex-row-reverse');
        dockWrap.classList.remove('justify-start');
        dockWrap.classList.add('justify-end');
        drawer.classList.remove('left-0', 'border-r', '-translate-x-full');
        drawer.classList.add('right-0', 'border-l');
        badge.textContent = 'Right-Hand';
        drawerLabel.textContent = 'Right';
        btnRight.className = activeBtnClass;
        btnLeft.className = inactiveBtnClass;
      }
      if (persist) {
        saveUserPreferences();
        showToast(`Hand Orientation: ${side === 'left' ? 'Left-Handed' : 'Right-Handed'}`, 'info');
      }
    };

    function applyTheme(theme, persist = true) {
      state.theme = theme;
      const htmlEl = document.documentElement;
      const label = document.getElementById('theme-status-label');
      if (theme === 'dark') {
        htmlEl.classList.add('dark');
        if (label) label.textContent = 'Night Mode (Obsidian)';
      } else {
        htmlEl.classList.remove('dark');
        if (label) label.textContent = 'Day Mode (Alabaster)';
      }
      if (persist) saveUserPreferences();
    }

    window.toggleTheme = function() {
      applyTheme(state.theme === 'dark' ? 'light' : 'dark', true);
    };

    window.setUiScale = function(val, persist = true) {
      state.uiScale = Number(val);
      document.getElementById('ui-scale-label').textContent = `${state.uiScale}%`;
      document.documentElement.style.fontSize = `${(state.uiScale / 100) * 16}px`;
      [90, 100, 110, 120].forEach(s => {
        const btn = document.getElementById(`scale-${s}`);
        if (!btn) return;
        btn.className = s === state.uiScale
          ? 'scale-btn py-1 text-[10px] font-extrabold rounded-lg bg-slate-900 dark:bg-champagne-500 text-white dark:text-obsidian-950 tabular-nums'
          : 'scale-btn py-1 text-[10px] font-bold rounded-lg text-slate-500 tabular-nums';
      });
      if (persist) saveUserPreferences();
    };

    window.setPhotoQuality = function(qual, persist = true) {
      state.photoQuality = qual;
      const labels = { low: 'Low (Fast)', medium: 'Medium', high: 'High (HD)' };
      document.getElementById('photo-quality-label').textContent = labels[qual];
      ['low', 'medium', 'high'].forEach(q => {
        const btn = document.getElementById(`qual-${q}`);
        btn.className = q === qual
          ? 'qual-btn py-1 text-[11px] font-bold rounded-lg bg-slate-900 dark:bg-champagne-500 text-white dark:text-obsidian-950'
          : 'qual-btn py-1 text-[11px] font-semibold rounded-lg text-slate-500';
      });
      if (persist) saveUserPreferences();
    };

    window.toggleViewDensity = function() {
      state.viewDensity = state.viewDensity === 'list' ? 'grid' : 'list';
      updateDensityIcon();
      saveUserPreferences();
      renderStockList();
    };

    function updateDensityIcon() {
      const iconEl = document.getElementById('density-icon');
      if (iconEl) {
        iconEl.setAttribute('data-lucide', state.viewDensity === 'list' ? 'layout-grid' : 'list');
        lucide.createIcons();
      }
    }

    // --- Profile Drawer ---
    window.openProfileDrawer = function() {
      document.getElementById('profile-drawer-backdrop').classList.remove('hidden');
      document.getElementById('profile-drawer').classList.remove('-translate-x-full', 'translate-x-full');
      lucide.createIcons();
    };

    window.closeProfileDrawer = function() {
      document.getElementById('profile-drawer-backdrop').classList.add('hidden');
      const drawer = document.getElementById('profile-drawer');
      if (state.handSide === 'left') drawer.classList.add('-translate-x-full');
      else drawer.classList.add('translate-x-full');
    };

    // --- Isolated Cloud & Offline Sync Data Engine ---
    function getLocalItemsKey() { return `smartstock_inv_${state.user?.uid}`; }
    function getLocalHistoryKey() { return `smartstock_hist_${state.user?.uid}`; }
    function getOfflineQueueKey() { return `smartstock_q_${state.user?.uid}`; }

    function loadOfflineQueue() {
      try {
        state.offlineQueue = JSON.parse(localStorage.getItem(getOfflineQueueKey()) || '[]');
      } catch (e) {
        state.offlineQueue = [];
      }
      updateConnectivityUI();
    }

    function saveOfflineQueue() {
      localStorage.setItem(getOfflineQueueKey(), JSON.stringify(state.offlineQueue));
      updateConnectivityUI();
    }

    function subscribeToUserStock() {
      if (!state.user) return;
      try {
        state.items = JSON.parse(localStorage.getItem(getLocalItemsKey()) || '[]');
        state.history = JSON.parse(localStorage.getItem(getLocalHistoryKey()) || '[]');
        renderDashboard();
      } catch (e) {}

      if (useCloudMode && db && auth?.currentUser) {
        const uid = auth.currentUser.uid;
        const itemsCol = collection(db, 'artifacts', appId, 'users', uid, 'inventory');
        const historyCol = collection(db, 'artifacts', appId, 'users', uid, 'history');

        state.unsubscribeItems = onSnapshot(itemsCol, (snapshot) => {
          const cloudItems = [];
          snapshot.forEach(docSnap => cloudItems.push({ id: docSnap.id, ...docSnap.data() }));
          cloudItems.sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0));
          state.items = cloudItems;
          localStorage.setItem(getLocalItemsKey(), JSON.stringify(state.items));
          renderDashboard();
        }, (err) => console.warn("Cloud items listener fallback:", err));

        state.unsubscribeHistory = onSnapshot(historyCol, (snapshot) => {
          const cloudHistory = [];
          snapshot.forEach(docSnap => cloudHistory.push({ id: docSnap.id, ...docSnap.data() }));
          cloudHistory.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
          state.history = cloudHistory;
          localStorage.setItem(getLocalHistoryKey(), JSON.stringify(state.history));
        }, (err) => console.warn("Cloud history listener fallback:", err));
      }
    }

    async function persistItemOperation(opType, itemData, historyEntry) {
      if (opType === 'upsert') {
        const idx = state.items.findIndex(i => i.id === itemData.id);
        if (idx >= 0) state.items[idx] = itemData;
        else state.items.unshift(itemData);
      } else if (opType === 'delete') {
        state.items = state.items.filter(i => i.id !== itemData.id);
      }

      if (historyEntry) {
        state.history.unshift(historyEntry);
        localStorage.setItem(getLocalHistoryKey(), JSON.stringify(state.history));
      }
      localStorage.setItem(getLocalItemsKey(), JSON.stringify(state.items));
      renderDashboard();

      if (useCloudMode && db && auth?.currentUser && isEffectivelyOnline()) {
        try {
          const uid = auth.currentUser.uid;
          if (opType === 'upsert') {
            await setDoc(doc(db, 'artifacts', appId, 'users', uid, 'inventory', itemData.id), itemData);
          } else if (opType === 'delete') {
            await deleteDoc(doc(db, 'artifacts', appId, 'users', uid, 'inventory', itemData.id));
          }
          if (historyEntry) {
            await addDoc(collection(db, 'artifacts', appId, 'users', uid, 'history'), historyEntry);
          }
        } catch (err) {
          state.offlineQueue.push({ opType, itemData, historyEntry });
          saveOfflineQueue();
        }
      } else if (useCloudMode && !isEffectivelyOnline()) {
        state.offlineQueue.push({ opType, itemData, historyEntry });
        saveOfflineQueue();
      }
    }

    async function flushOfflineQueue() {
      if (!useCloudMode || !db || !auth?.currentUser || !isEffectivelyOnline() || state.offlineQueue.length === 0) {
        return;
      }
      const uid = auth.currentUser.uid;
      const queueCopy = [...state.offlineQueue];
      state.offlineQueue = [];
      saveOfflineQueue();

      for (const task of queueCopy) {
        try {
          if (task.opType === 'upsert') {
            await setDoc(doc(db, 'artifacts', appId, 'users', uid, 'inventory', task.itemData.id), task.itemData);
          } else if (task.opType === 'delete') {
            await deleteDoc(doc(db, 'artifacts', appId, 'users', uid, 'inventory', task.itemData.id));
          }
          if (task.historyEntry) {
            const syncedEntry = { ...task.historyEntry, offlineSynced: false };
            await addDoc(collection(db, 'artifacts', appId, 'users', uid, 'history'), syncedEntry);
          }
        } catch (e) {
          state.offlineQueue.push(task);
        }
      }
      saveOfflineQueue();
      if (state.offlineQueue.length === 0) {
        showToast('Offline ledger synced to Cloud.', 'success');
      }
    }

    // --- Quick +/- Inline Stock Adjustment ---
    window.quickAdjustItemStock = async function(itemId, delta) {
      const item = state.items.find(i => i.id === itemId);
      if (!item) return;
      const currentQty = Number(item.quantity) || 0;
      if (delta < 0 && currentQty <= 0) {
        showToast(`"${item.name}" is already at 0 stock.`, 'warning');
        return;
      }
      const nextQty = Math.max(0, currentQty + delta);
      const updated = { ...item, quantity: nextQty, updatedAt: Date.now() };
      const historyObj = {
        type: delta > 0 ? 'IN' : 'OUT',
        itemName: item.name,
        quantity: Math.abs(delta),
        resultingStock: nextQty,
        image: item.image || null,
        timestamp: Date.now(),
        offlineSynced: !isEffectivelyOnline()
      };
      await persistItemOperation('upsert', updated, historyObj);
      if (delta < 0 && nextQty <= Number(item.threshold ?? 5)) {
        showToast(`Low Stock Alert: "${item.name}" (${nextQty} left)`, 'warning');
      }
