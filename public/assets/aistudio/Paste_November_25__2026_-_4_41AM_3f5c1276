    window.submitStockEntry = async function(e) {
      e.preventDefault();
      const name = document.getElementById('entry-item-name').value.trim();
      const extractedText = document.getElementById('entry-item-ocr').value.trim();
      const designDetails = document.getElementById('entry-item-design').value.trim();
      const category = document.getElementById('entry-item-category').value.trim() || 'General';
      const threshold = Math.max(0, Number(document.getElementById('entry-item-threshold').value) || 5);
      const qtyDelta = Math.max(1, Number(document.getElementById('entry-item-qty').value) || 1);
      const matchedId = document.getElementById('matched-item-id').value;

      if (!name) {
        showToast('Please enter or confirm the variant product name.', 'error');
        return;
      }

      let existing = matchedId ? state.items.find(i => i.id === matchedId) : null;
      if (!existing) {
        // Only auto-match by exact name + exact embossed text so different variants stay separate!
        existing = state.items.find(i => {
          const sameName = i.name.toLowerCase() === name.toLowerCase();
          const oldOcr = (i.extractedText || '').toLowerCase();
          const newOcr = extractedText.toLowerCase();
          return sameName && oldOcr === newOcr;
        });
      }

      if (state.scanMode === 'IN') {
        const newQty = (existing ? Number(existing.quantity) : 0) + qtyDelta;
        const itemObj = {
          id: existing ? existing.id : 'itm_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
          name,
          extractedText,
          designDetails,
          category,
          quantity: newQty,
          threshold,
          image: state.capturedImageBase64 || (existing ? existing.image : null),
          fingerprint: state.capturedFingerprint || (existing ? existing.fingerprint : null),
          updatedAt: Date.now()
        };

        const historyObj = {
          type: 'IN',
          itemName: extractedText ? `${name} [${extractedText}]` : name,
          quantity: qtyDelta,
          resultingStock: newQty,
          image: itemObj.image,
          timestamp: Date.now(),
          offlineSynced: !isEffectivelyOnline()
        };

        await persistItemOperation('upsert', itemObj, historyObj);
        showToast(`+${qtyDelta} "${name}" logged · Total: ${newQty}`, 'success');
      } else {
        if (!existing) {
          showToast('Variant not selected. Pick the exact item in Confirmation or Help above.', 'error');
          return;
        }
        if (Number(existing.quantity) < qtyDelta) {
          showToast(`Insufficient stock: only ${existing.quantity} units available.`, 'error');
          return;
        }

        const newQty = Number(existing.quantity) - qtyDelta;
        const itemObj = {
          ...existing,
          name,
          extractedText: extractedText || existing.extractedText || '',
          designDetails: designDetails || existing.designDetails || '',
          category,
          quantity: newQty,
          image: existing.image || state.capturedImageBase64,
          updatedAt: Date.now()
        };

        const historyObj = {
          type: 'OUT',
          itemName: itemObj.extractedText ? `${name} [${itemObj.extractedText}]` : name,
          quantity: qtyDelta,
          resultingStock: newQty,
          image: itemObj.image,
          timestamp: Date.now(),
          offlineSynced: !isEffectivelyOnline()
        };

        await persistItemOperation('upsert', itemObj, historyObj);

        if (newQty <= Number(itemObj.threshold ?? 5)) {
          showToast(`Low Stock Warning: "${name}" is at ${newQty} units`, 'warning');
        } else {
          showToast(`-${qtyDelta} "${name}" deducted · Remaining: ${newQty}`, 'success');
        }
      }

      closeScanModal();
    };

