    // --- Camera, Perceptual Image Fingerprinting & Compression ---
    function computeImageFingerprint(img) {
      try {
        const size = 16;
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, size, size);
        const data = ctx.getImageData(0, 0, size, size).data;

        const lum = [];
        let rSum = 0, gSum = 0, bSum = 0;
        let centerLum = 0, ringLum = 0, outerLum = 0;
        let centerCnt = 0, ringCnt = 0, outerCnt = 0;

        for (let y = 0; y < size; y++) {
          for (let x = 0; x < size; x++) {
            const idx = (y * size + x) * 4;
            const r = data[idx], g = data[idx + 1], b = data[idx + 2];
            rSum += r; gSum += g; bSum += b;
            const l = 0.299 * r + 0.587 * g + 0.114 * b;
            lum.push(l);

            const dx = (x - 7.5) / 7.5;
            const dy = (y - 7.5) / 7.5;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 0.38) { centerLum += l; centerCnt++; }
            else if (dist < 0.78) { ringLum += l; ringCnt++; }
            else { outerLum += l; outerCnt++; }
          }
        }

        const totalPx = size * size;
        const meanLum = lum.reduce((a, b) => a + b, 0) / totalPx;
        const hashBits = lum.map(v => (v >= meanLum ? '1' : '0')).join('');

        // Edge energy (horizontal + vertical gradient contrast)
        let edgeSum = 0;
        for (let y = 0; y < size - 1; y++) {
          for (let x = 0; x < size - 1; x++) {
            const c = lum[y * size + x];
            edgeSum += Math.abs(c - lum[y * size + (x + 1)]) + Math.abs(c - lum[(y + 1) * size + x]);
          }
        }

        return {
          hash: hashBits,
          avgRgb: [Math.round(rSum / totalPx), Math.round(gSum / totalPx), Math.round(bSum / totalPx)],
          radial: [
            Math.round(centerLum / Math.max(1, centerCnt)),
            Math.round(ringLum / Math.max(1, ringCnt)),
            Math.round(outerLum / Math.max(1, outerCnt))
          ],
          edgeDensity: Math.round(edgeSum / totalPx)
        };
      } catch (e) {
        return null;
      }
    }

    function compareFingerprints(fpA, fpB) {
      if (!fpA || !fpB || !fpA.hash || !fpB.hash) return 0;
      let sameBits = 0;
      const len = Math.min(fpA.hash.length, fpB.hash.length);
      for (let i = 0; i < len; i++) {
        if (fpA.hash[i] === fpB.hash[i]) sameBits++;
      }
      const hashSim = sameBits / len;

      const colorDist = Math.sqrt(
        Math.pow(fpA.avgRgb[0] - fpB.avgRgb[0], 2) +
        Math.pow(fpA.avgRgb[1] - fpB.avgRgb[1], 2) +
        Math.pow(fpA.avgRgb[2] - fpB.avgRgb[2], 2)
      );
      const colorSim = Math.max(0, 1 - colorDist / 220);

      const radialDist =
        Math.abs(fpA.radial[0] - fpB.radial[0]) +
        Math.abs(fpA.radial[1] - fpB.radial[1]) +
        Math.abs(fpA.radial[2] - fpB.radial[2]);
      const radialSim = Math.max(0, 1 - radialDist / 300);

      const edgeSim = Math.max(0, 1 - Math.abs((fpA.edgeDensity || 0) - (fpB.edgeDensity || 0)) / 90);

      return Math.round((hashSim * 0.45 + colorSim * 0.25 + radialSim * 0.15 + edgeSim * 0.15) * 100);
    }

    function compressImageDataUrl(dataUrl) {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          const fingerprint = computeImageFingerprint(img);
          const qualityMap = {
            low: { maxDim: 360, jpegQual: 0.55 },
            medium: { maxDim: 640, jpegQual: 0.72 },
            high: { maxDim: 1024, jpegQual: 0.88 }
          };
          const cfg = qualityMap[state.photoQuality] || qualityMap.medium;
          let { width, height } = img;
          if (width > cfg.maxDim || height > cfg.maxDim) {
            if (width > height) {
              height = Math.round((height * cfg.maxDim) / width);
              width = cfg.maxDim;
            } else {
              width = Math.round((width * cfg.maxDim) / height);
              height = cfg.maxDim;
            }
          }
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          canvas.getContext('2d').drawImage(img, 0, 0, width, height);
          resolve({
            dataUrl: canvas.toDataURL('image/jpeg', cfg.jpegQual),
            fingerprint
          });
        };
        img.src = dataUrl;
      });
    }

