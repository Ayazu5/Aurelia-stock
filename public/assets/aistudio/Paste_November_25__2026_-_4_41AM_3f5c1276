            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Low Stock Alert Threshold</label>
            <input id="edit-modal-threshold" type="number" min="0" required class="w-full px-3.5 py-2.5 rounded-xl bg-alabaster-50 dark:bg-obsidian-850 border hairline-border text-sm font-bold tabular-nums" />
