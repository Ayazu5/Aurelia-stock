    // --- Local Visual / Offline Fallback Matcher (Prevents Blind Merging) ---
    function runLocalVisualComparisonFallback(fingerprint) {
      const scored = state.items
        .map(item => ({
          item,
          score: item.fingerprint ? compareFingerprints(fingerprint, item.fingerprint) : 0
        }))
        .filter(x => x.score >= 52)
        .sort((a, b) => b.score - a.score);

      if (scored.length > 0) {
        const candidates = scored.slice(0, 3).map(s => ({
          id: s.item.id,
          similarity: s.score,
          reason: `${s.score}% visual silhouette/color match — verify embossed text before merging`
        }));
        const fallbackSuggestion = {
          suggestedName: '',
          extractedText: '',
          designDetails: 'Offline manual capture',
          category: scored[0].item.category || 'General',
          suggestedThreshold: scored[0].item.threshold ?? 5
        };
        showDisambiguationPrompt(
          candidates,
          fallbackSuggestion,
          'Offline visual scan found similar silhouette/color items. Select an existing SKU or list as a new variant.'
        );
      } else {
        showToast('Offline · Manual Mode: Enter variant name & embossed text below.', 'warning');
      }
    }

    // --- Gemini AI Fine-Grained Vision + Embossed Text (OCR) + Disambiguation ---
    async function analyzeImageWithGemini(base64DataUrl, fingerprint) {
      const loader = document.getElementById('ai-scanning-loader');
      const laser = document.getElementById('laser-overlay');
      const banner = document.getElementById('ai-match-banner');
      const disambigCard = document.getElementById('ai-disambiguation-card');

      loader.classList.remove('hidden');
      laser.classList.remove('hidden');
      banner.classList.add('hidden');
      disambigCard.classList.add('hidden');

      const base64Clean = base64DataUrl.split(',')[1];
      const existingCatalog = state.items.map(i => ({
        id: i.id,
        name: i.name,
        extractedText: i.extractedText || '',
        designDetails: i.designDetails || '',
        category: i.category || 'General',
        quantity: i.quantity,
        threshold: i.threshold ?? 5
      }));

      const prompt = `You are a high-precision Industrial & Apparel Vision AI Inventory Inspector with micro-OCR capability.
Your #1 job is to distinguish DIFFERENT variants of visually similar hardware/items (such as different embossed black jeans buttons, rivets, labels, electronic parts, or bottles) so they NEVER merge into the wrong SKU!

Step 1 — MICRO-OCR & SURFACE RELIEF INSPECTION:
- Read EVERY embossed, debossed, stamped, or printed word/number on the item (even curved or upside-down text around rims or banners, such as "DENIM CO.", "ESTD 1966 JEANS DENIM", "JEANS WEAR", serial codes, or brand logos). Put the exact readable text in "extractedText".
- Describe the physical design & surface relief in "designDetails" (e.g., "Matte black circular shank button, central chevron logo, single outer rim", or "Glossy black double-ring button with curved rim text", or "Black button with diagonal rectangular banner").
- Create a specific variant SKU name in "suggestedName" combining the item type + extracted text (e.g., 'Jeans Button — "DENIM CO."' or 'Jeans Button — "ESTD 1966 JEANS DENIM"' or 'Jeans Button — "JEANS WEAR"'). If no text exists, describe the unique motif.

Step 2 — COMPARE AGAINST EXISTING SAVED INVENTORY:
${JSON.stringify(existingCatalog)}

- Only set "exactMatchId" if BOTH the physical design AND the embossed/printed text ("extractedText") match an existing saved item with >= 90% certainty!
- If an existing saved item has the same base product/color (e.g., another black Jeans Button) OR has different/unclear embossed text, OR you are between 45% and 89% confident, set "isAmbiguous": true, set "exactMatchId": null, and list the similar existing items in "similarCandidates" so the user can choose whether to add to an existing SKU or list as a brand-new individual SKU!

Respond ONLY in valid JSON:
{
  "exactMatchId": string or null,
  "isAmbiguous": boolean,
  "confidence": number,
  "extractedText": string,
  "designDetails": string,
  "suggestedName": string,
  "category": string,
  "suggestedThreshold": number,
  "confidenceNote": string,
  "similarCandidates": [
    { "id": string, "similarity": number, "reason": string }
  ]
}`;

      const apiKey = "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`;

      const payload = {
        contents: [
          {
            role: "user",
            parts: [
              { text: prompt },
              {
                inlineData: {
                  mimeType: "image/jpeg",
                  data: base64Clean
                }
              }
            ]
          }
        ],
        generationConfig: {
          responseMimeType: "application/json"
        }
      };

      let attempt = 0;
      const delays = [1000, 2000, 4000];
      let aiResult = null;

      while (attempt < 3) {
        try {
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
          if (rawText) {
            aiResult = JSON.parse(rawText);
            break;
          }
        } catch (err) {
          if (attempt < 2) await new Promise(r => setTimeout(r, delays[attempt]));
        }
        attempt++;
      }

      loader.classList.add('hidden');
      laser.classList.add('hidden');

      if (!aiResult) {
        runLocalVisualComparisonFallback(fingerprint);
        return;
      }

      // Also supplement AI's similarCandidates with perceptual fingerprint similarity for same-category/color items
      const candidateMap = new Map();
      if (Array.isArray(aiResult.similarCandidates)) {
        aiResult.similarCandidates.forEach(c => {
          const found = state.items.find(i => i.id === c.id);
          if (found) {
            candidateMap.set(found.id, {
              id: found.id,
              similarity: Math.min(99, Math.max(45, Number(c.similarity) || 72)),
              reason: c.reason || 'Similar shape/category detected'
            });
          }
        });
      }

      // Check perceptual similarity & shared base category/name tokens
      const suggestedLower = (aiResult.suggestedName || '').toLowerCase();
      const catLower = (aiResult.category || '').toLowerCase();
      state.items.forEach(item => {
        if (candidateMap.has(item.id)) return;
        const fpScore = item.fingerprint ? compareFingerprints(fingerprint, item.fingerprint) : 0;
        const sameCategory = catLower && (item.category || '').toLowerCase() === catLower;
        const sharesKeyword = suggestedLower.split(/[\s—\-"]+/).some(tok => tok.length > 3 && item.name.toLowerCase().includes(tok));
        if (fpScore >= 64 || (sameCategory && sharesKeyword)) {
          candidateMap.set(item.id, {
            id: item.id,
            similarity: Math.max(fpScore, 68),
            reason: item.extractedText
              ? `Saved engraving: "${item.extractedText}"`
              : `Same category (${item.category || 'General'})`
          });
        }
      });

      const exactItem = aiResult.exactMatchId
        ? state.items.find(i => i.id === aiResult.exactMatchId)
        : null;

      // Verify exactItem doesn't have conflicting embossed text
      let verifiedExactItem = exactItem;
      if (verifiedExactItem && aiResult.extractedText && verifiedExactItem.extractedText) {
        const normNew = aiResult.extractedText.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
        const normOld = verifiedExactItem.extractedText.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
        if (normNew && normOld && normNew !== normOld) {
          // Different embossed text! Do NOT auto-merge; trigger confirmation prompt instead
          candidateMap.set(verifiedExactItem.id, {
            id: verifiedExactItem.id,
            similarity: 74,
            reason: `Different marking ("${verifiedExactItem.extractedText}" vs "${aiResult.extractedText}")`
          });
          verifiedExactItem = null;
        }
      }

      const allCandidates = Array.from(candidateMap.values()).sort((a, b) => b.similarity - a.similarity);

      // Update OCR & Design Chips in AI Banner
      populateAiBannerChips(aiResult);

      if (verifiedExactItem && !aiResult.isAmbiguous) {
        // High-confidence exact match (both design & embossed text match)
        document.getElementById('matched-item-id').value = verifiedExactItem.id;
        document.getElementById('entry-item-name').value = verifiedExactItem.name;
        document.getElementById('entry-item-ocr').value = verifiedExactItem.extractedText || aiResult.extractedText || '';
        document.getElementById('entry-item-design').value = verifiedExactItem.designDetails || aiResult.designDetails || '';
        document.getElementById('entry-item-category').value = verifiedExactItem.category || aiResult.category || 'General';
        document.getElementById('entry-item-threshold').value = verifiedExactItem.threshold ?? 5;
        if (state.scanMode === 'OUT') {
          document.getElementById('manual-stock-out-select').value = verifiedExactItem.id;
        }
        banner.classList.remove('hidden');
        document.getElementById('ai-match-title').textContent = `Exact Variant Match · ${verifiedExactItem.quantity} in stock`;
        document.getElementById('ai-confidence-pill').textContent = `${aiResult.confidence || 96}% Match`;
        document.getElementById('ai-match-desc').textContent = aiResult.confidenceNote || `Matched "${verifiedExactItem.name}". All fields remain editable below.`;
      } else if (allCandidates.length > 0) {
        // AI found similar variants or is unsure whether to merge or list as new SKU
        banner.classList.remove('hidden');
        document.getElementById('ai-match-title').textContent = aiResult.extractedText
          ? `Detected Text: "${aiResult.extractedText}"`
          : 'New Variant Analyzed';
        document.getElementById('ai-confidence-pill').textContent = 'Confirm SKU';
        document.getElementById('ai-match-desc').textContent = aiResult.confidenceNote || 'Review similar items below to add to an existing SKU or list separately.';

        showDisambiguationPrompt(
          allCandidates,
          aiResult,
          state.scanMode === 'IN'
            ? 'Similar item(s) exist in your inventory. Add stock to an existing SKU or list this as a new individual item?'
            : 'Multiple similar variants exist. Confirm which exact SKU to deduct stock from:'
        );
      } else {
        // Brand-new distinct item with no similar conflicts
        document.getElementById('matched-item-id').value = '';
        document.getElementById('entry-item-name').value = aiResult.suggestedName || '';
        document.getElementById('entry-item-ocr').value = aiResult.extractedText || '';
        document.getElementById('entry-item-design').value = aiResult.designDetails || '';
        document.getElementById('entry-item-category').value = aiResult.category || 'General';
        document.getElementById('entry-item-threshold').value = aiResult.suggestedThreshold || 5;

        banner.classList.remove('hidden');
        document.getElementById('ai-match-title').textContent = state.scanMode === 'IN'
          ? 'New Individual SKU Ready'
          : 'No Matching Saved SKU';
        document.getElementById('ai-confidence-pill').textContent = aiResult.extractedText ? 'OCR Extracted' : 'AI Suggested';
        document.getElementById('ai-match-desc').textContent = aiResult.confidenceNote || 'Verify the extracted text and product name below.';
      }

      lucide.createIcons();
    }

    function populateAiBannerChips(aiResult) {
      const chipsRow = document.getElementById('ai-extracted-chips');
      const ocrChip = document.getElementById('ai-ocr-chip');
      const designChip = document.getElementById('ai-design-chip');

      const hasOcr = Boolean(aiResult.extractedText && aiResult.extractedText.trim());
      const hasDesign = Boolean(aiResult.designDetails && aiResult.designDetails.trim());

      if (hasOcr || hasDesign) {
        chipsRow.classList.remove('hidden');
